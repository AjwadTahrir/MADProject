<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="#EEEEEE"
    app:cardBackgroundColor="#FFFFFF">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <androidx.cardview.widget.CardView
            android:id="@+id/cardImg"
            android:layout_width="70dp"
            android:layout_height="70dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#F1F8E9"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">
            <ImageView
                android:id="@+id/imgMyFood"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_launcher_foreground"/>
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/tvMyFoodTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Food Title"
            android:textStyle="bold"
            android:textColor="#000000"
            android:textSize="16sp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintStart_toEndOf="@id/cardImg"
            app:layout_constraintTop_toTopOf="@id/cardImg"
            app:layout_constraintEnd_toStartOf="@id/tvStatus"/>

        <TextView
            android:id="@+id/tvMyFoodPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$2.00 / each"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#006064"
            android:background="@drawable/bg_pill_price_cyan"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:layout_marginTop="8dp"
            app:layout_constraintStart_toStartOf="@id/tvMyFoodTitle"
            app:layout_constraintTop_toBottomOf="@id/tvMyFoodTitle"/>

        <TextView
            android:id="@+id/tvMyFoodQuantity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4/4 available"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#006064"
            android:background="@drawable/bg_pill_price_cyan"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:layout_marginStart="8dp"
            app:layout_constraintStart_toEndOf="@id/tvMyFoodPrice"
            app:layout_constraintTop_toTopOf="@id/tvMyFoodPrice"
            app:layout_constraintBottom_toBottomOf="@id/tvMyFoodPrice"/>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="active"
            android:textSize="10sp"
            android:textColor="#2E7D32"
            android:background="@drawable/bg_pill_active"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <TextView
            android:id="@+id/tvDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Jan 09"
            android:textSize="12sp"
            android:textColor="#BDBDBD"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>